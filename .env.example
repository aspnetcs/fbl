# 课堂行为检测 MCP - 环境变量模板
# 用法: 复制本文件为 scripts\.env 并填写(留空项由启动脚本自动处理)

# 项目根目录(留空=自动用启动脚本所在目录, 一般不用改)
MCP_PROJECT_DIR=

# 鉴权令牌(强烈建议设一个随机字符串; 留空=本地调试免鉴权模式)
MCP_AUTH_TOKEN=

MCP_PORT=9800
MCP_MAX_CONCURRENT=2

# ---- 腾讯云COS(可选, 配置后检测结果自动上传COS, 链接更稳定) ----
# MCP_COS_SECRET_ID=
# MCP_COS_SECRET_KEY=
# MCP_COS_REGION=ap-guangzhou
# MCP_COS_BUCKET=
# MCP_COS_PREFIX=mcp-results/
# MCP_RESULTS_TTL_SEC=604800
